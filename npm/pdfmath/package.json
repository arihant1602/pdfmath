    "mcp-server",
    "model-context-protocol",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arihant1602/pdfmath.git"
  },
  "homepage": "https://github.com/arihant1602/pdfmath#readme",
  "bugs": {
    "url": "https://github.com/arihant1602/pdfmath/issues"
  },
  "bin": {
    "pdfm": "bin/pdfm.js"
  },
  "files": [
    "bin/pdfm.js",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "optionalDependencies": {
    "pdfmath-linux-x64": "0.1.0",
    "pdfmath-linux-arm64": "0.1.0",
    "pdfmath-darwin-x64": "0.1.0",
    "pdfmath-darwin-arm64": "0.1.0",
    "pdfmath-windows-x64": "0.1.0",
    "pdfmath-windows-arm64": "0.1.0"
  }
